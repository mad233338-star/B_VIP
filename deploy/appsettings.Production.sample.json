{
  "//": "Copy to appsettings.Production.json next to B_VIP.Backend.dll and replace every CHANGE_ME value. Secrets may also be supplied as environment variables (Auth__SigningKey, Security__SecretEncryptionKey, Bootstrap__FirstAdminToken, ConnectionStrings__Default); environment variables win over this file.",
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=b_vip;Username=b_vip_app;Password=CHANGE_ME;Pooling=true;SSL Mode=Prefer;Timeout=15;Command Timeout=120"
  },
  "Auth": {
    "SigningKey": "CHANGE_ME_minimum_32_characters_of_random_data",
    "Issuer": "B_VIP.Backend",
    "Audience": "B_VIP.Clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "PasswordResetMinutes": 30,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetPerEmailPerHour": 5
  },
  "Security": {
    "SecretEncryptionKey": "CHANGE_ME_32_bytes_of_random_data_used_for_AES"
  },
  "Bootstrap": {
    "FirstAdminToken": "CHANGE_ME_one_time_token_to_create_the_first_super_admin",
    "AllowFirstAdminBootstrap": true
  },
  "Storage": {
    "DataDirectory": "C:\\ProgramData\\B_VIP\\data",
    "BackupDirectory": "C:\\ProgramData\\B_VIP\\backups",
    "UploadDirectory": "C:\\ProgramData\\B_VIP\\uploads",
    "MaxUploadBytes": 10485760,
    "ReportRetentionDays": 180,
    "AuditRetentionDays": 730,
    "PgDumpPath": "C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe",
    "PgRestorePath": "C:\\Program Files\\PostgreSQL\\16\\bin\\pg_restore.exe"
  },
  "License": {
    "OfflineGraceHours": 72,
    "AllowOfflineWork": false,
    "VerificationCacheMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "https://admin.example.com" ]
  },
  "OpenApi": {
    "ExposeInProduction": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\B_VIP\\logs\\backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "B_VIP.Backend"
    }
  },
  "AllowedHosts": "*"
}
