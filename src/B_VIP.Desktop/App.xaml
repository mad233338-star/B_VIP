<Application x:Class="B_VIP.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:views="clr-namespace:B_VIP.Desktop.Views"
             xmlns:admin="clr-namespace:B_VIP.Admin;assembly=B_VIP.Admin"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/CyberBlue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceManagerViewModel}">
                <views:DevicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdbViewModel}">
                <views:AdbView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FastbootViewModel}">
                <views:FastbootView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SamsungViewModel}">
                <views:SamsungView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VendorViewModel}">
                <views:VendorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MtkViewModel}">
                <views:MtkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QualcommViewModel}">
                <views:QualcommView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SpdViewModel}">
                <views:SpdView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}">
                <views:DriversView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GoogleRecoveryViewModel}">
                <views:GoogleRecoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OperationsViewModel}">
                <views:OperationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LicenseViewModel}">
                <views:LicenseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubscriptionViewModel}">
                <views:SubscriptionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupportViewModel}">
                <views:SupportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
                <views:NotificationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TermsViewModel}">
                <views:TermsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyPolicyViewModel}">
                <views:PrivacyPolicyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdminViewModel}">
                <views:AdminView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
