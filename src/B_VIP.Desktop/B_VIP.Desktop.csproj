<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>B_VIP.Desktop</RootNamespace>
    <AssemblyName>B_VIP.Desktop</AssemblyName>
    <AssemblyTitle>B_VIP Tool</AssemblyTitle>
    <ApplicationIcon>Assets/b_vip.ico</ApplicationIcon>
    <Description>B_VIP Tool desktop application by Bashir Al-Farhan.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../B_VIP.Core/B_VIP.Core.csproj" />
    <ProjectReference Include="../B_VIP.Contracts/B_VIP.Contracts.csproj" />
    <ProjectReference Include="../B_VIP.Application/B_VIP.Application.csproj" />
    <ProjectReference Include="../B_VIP.CloudClient/B_VIP.CloudClient.csproj" />
    <ProjectReference Include="../B_VIP.Hardware/B_VIP.Hardware.csproj" />
    <ProjectReference Include="../B_VIP.Modules/B_VIP.Modules.csproj" />
    <ProjectReference Include="../B_VIP.Admin/B_VIP.Admin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Default client settings (server address, language) copied next to the executable. -->
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
