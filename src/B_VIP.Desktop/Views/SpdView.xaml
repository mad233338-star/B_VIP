<UserControl x:Class="B_VIP.Desktop.Views.SpdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SpdViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Accent}" VerticalAlignment="Center">
                <TextBlock Text="UNISOC · BROM / DIAG / FDL1 + FDL2" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
            </Border>
            <!-- Micro status pill: the loader state at a glance, without opening the card. -->
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Status}" VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    BorderBrush="{Binding Loaders.Status, Converter={StaticResource StatusToBrush}}">
                <TextBlock Text="{Binding Loaders.HeaderStatusText}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Loaders.Status, Converter={StaticResource StatusToBrush}}" />
            </Border>
            <TextBlock Text="SPREADTRUM (Unisoc)" Style="{StaticResource Text.PageTitle}" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- LastChildFill stays off so the primary action keeps its own width instead of
                     stretching across the header when it is the last dock child. -->
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Interfaces" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Button.Outline}"
                            Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Read info" Style="{StaticResource Button.Primary}"
                            Command="{Binding ReadInfoCommand}" VerticalAlignment="Center"
                            ToolTip="Enumerates the Unisoc interfaces and reads the platform over adb when a handset is booted." />
                </DockPanel>

                <Border Margin="0,10,0,0" Background="{StaticResource Brush.Surface}" CornerRadius="4"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Height="96">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <ItemsControl ItemsSource="{Binding Ports}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}"
                                               FontFamily="Consolas" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Port" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding PortChoices}" SelectedItem="{Binding SelectedPort}"
                              ToolTip="Leave on auto-detect unless several Unisoc interfaces are attached." />
                </DockPanel>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding BrowseFdl1Command}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="FDL1" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding Fdl1Name, Mode=OneWay}"
                             ToolTip="{Binding Fdl1Tooltip}" />
                </DockPanel>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding BrowseFdl2Command}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="FDL2" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding Fdl2Name, Mode=OneWay}"
                             ToolTip="{Binding Fdl2Tooltip}" />
                </DockPanel>

                <!-- PAC firmware: independent of the loader bundle, so it stays on screen even when
                     the release bundle is already installed and its card has collapsed. -->
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,12,0,0" />

                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="PAC firmware" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding SelectPacCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Choose the .pac packet whose FDL1/FDL2 are extracted." />
                    <Button DockPanel.Dock="Right" Content="Extract loaders" Style="{StaticResource Button.Primary}"
                            Command="{Binding ExtractPacCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Reads the PAC header table and unpacks FDL1/FDL2 for the boot-ROM upload." />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding PacName, Mode=OneWay}"
                             ToolTip="{Binding PacTooltip}" />
                </DockPanel>

                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding PacSummary}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="BROM handshake" Style="{StaticResource Button.Outline}"
                            Command="{Binding HandshakeCommand}" Margin="0,0,8,8"
                            ToolTip="Sends the 0x7E synchronisation byte and reports exactly what the boot ROM answered." />
                    <Button Content="Upload FDL" Style="{StaticResource Button.Outline}"
                            Command="{Binding UploadFdlCommand}" Margin="0,0,8,8"
                            ToolTip="Streams FDL1 (and FDL2) in CRC-checked blocks over the synchronised boot ROM." />
                    <Button Content="Reset FRP" Style="{StaticResource Button.Outline}"
                            Command="{Binding ResetFrpCommand}" Margin="0,0,8,8"
                            ToolTip="Erases 'frp' and 'persistent' through fastboot; needs an unlocked bootloader." />
                    <Button Content="Factory format" Style="{StaticResource Button.Outline}"
                            Command="{Binding FactoryResetCommand}" Margin="0,0,8,8"
                            ToolTip="Erases userdata and cache only; persist, prodnv, nvram, nvdata and modem are protected." />
                    <ComboBox Style="{StaticResource Input.Select}" Width="130" Margin="0,0,8,8"
                              VerticalAlignment="Center" ItemsSource="{Binding RebootTargets}"
                              SelectedItem="{Binding SelectedRebootTarget}" />
                    <Button Content="Reboot" Style="{StaticResource Button.Outline}"
                            Command="{Binding RebootCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="The boot ROM exposes storage only after FDL1 runs, so partition work goes through fastboot and needs an unlocked bootloader. Loader images are supplied by the operator because they must match the SoC." />
            </StackPanel>
        </Border>

        <!-- Loader bundle: only on screen while it is missing, moving or failed. An installed
             bundle collapses the card and hands its height to the results grid below. -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,0,0,12"
                Visibility="{Binding Loaders.ShowCard, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Loaders" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Status}" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Loaders.StatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Button.Outline}"
                            Command="{Binding Loaders.CancelCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Loaders.IsProvisioning, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding Loaders.PrepareButtonText}" Style="{StaticResource Button.Outline}"
                            Command="{Binding Loaders.PrepareCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Loaders.ShowPrepareButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Fetches and installs the Unisoc bundle (SC9863A binaries and spd_dump)." />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Loaders.PackageName}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             Value="{Binding Loaders.Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding Loaders.IsIndeterminate}"
                             Visibility="{Binding Loaders.ShowProgressBar, Converter={StaticResource BoolToVisibility}}"
                             Background="{StaticResource Brush.Line}" Foreground="{StaticResource Brush.Accent}" />

                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Loaders.Detail}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
