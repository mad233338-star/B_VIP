<Window x:Class="B_VIP.Desktop.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:admin="clr-namespace:B_VIP.Admin;assembly=B_VIP.Admin"
        xmlns:views="clr-namespace:B_VIP.Desktop.Views"
        mc:Ignorable="d"
        Title="B_VIP Tool — Administrator Console"
        Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Black}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Administrator sidebar. This is a dedicated console: there is no switch to the technician workspace. -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,6">
                    <TextBlock Text="B_VIP Tool" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Gold}" />
                    <TextBlock Text="Administrator console" FontSize="11"
                               Foreground="{StaticResource Brush.Grey}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,0">
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="12"
                            BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SIGNED IN" Style="{StaticResource Text.Kicker}" />
                            <TextBlock Text="{Binding UserName}" Foreground="{StaticResource Brush.White}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            <TextBlock Text="Lifetime administrator" Foreground="{StaticResource Brush.AccentSoft}"
                                       FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Line}"
                        BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <!-- Account section, above the sign-out action. -->
                        <TextBlock Text="Account" Foreground="{StaticResource Brush.GoldDark}"
                                   FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                        <TextBlock Text="{Binding UserName}" Foreground="{StaticResource Brush.White}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                        <Button Content="Sign out" Style="{StaticResource Button.Outline}"
                                Padding="10,4" FontSize="11" Margin="4,10,0,0"
                                HorizontalAlignment="Left" Click="OnSignOut" />
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="Licenses, technicians, plans and platform telemetry are managed here."
                               Foreground="{StaticResource Brush.Grey}" FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UserName}"
                               Foreground="{StaticResource Brush.Grey}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="Administration" Foreground="{StaticResource Brush.GoldSoft}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <admin:AdminConsoleView DataContext="{Binding Model.Inner}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
