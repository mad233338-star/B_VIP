<UserControl x:Class="B_VIP.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeviceManagerViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                        Style="{StaticResource Button.Gold}" Command="{Binding ScanCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" />
        </DockPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [devices.serial], Source={x:Static loc:Localizer.Instance}}" Binding="{Binding Serial}" Width="150" />
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="120" />
                <DataGridTextColumn Header="{Binding [devices.model], Source={x:Static loc:Localizer.Instance}}" Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="{Binding [devices.state], Source={x:Static loc:Localizer.Instance}}" Binding="{Binding State}" Width="110" />
                <DataGridTextColumn Header="{Binding [devices.interface], Source={x:Static loc:Localizer.Instance}}" Binding="{Binding InterfaceType}" Width="110" />
                <DataGridTextColumn Header="Detail" Binding="{Binding InterfaceDetail}" Width="*" />
                <DataGridTextColumn Header="Android" Binding="{Binding AndroidVersion}" Width="90" />
                <DataGridTextColumn Header="Detected by" Binding="{Binding DetectedBy}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Live USB/COM ports: the watcher fills this list on every connect/disconnect. -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Card}" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Detected ports" Style="{StaticResource Text.Section}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Monitor.Summary}"
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,6" />

                    <!-- Connected interfaces: refreshed by the port watcher on every plug/unplug, so
                         the active COM port is visible the moment the handset enters a service mode. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="Connected devices" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Monitor.Ports}"
                                  DisplayMemberPath="Summary" VerticalAlignment="Center"
                                  ToolTip="{Binding Monitor.ConnectionStatus}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Monitor.Detail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Visibility="{Binding Monitor.Ports.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Monitor.Ports.Count, Converter={StaticResource NullToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Monitor.Ports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource Brush.AccentSoft}"
                                                   FontSize="11.5" MinWidth="110" />
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel.Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding [devices.tools], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding ToolStatuses}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.Grey}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Found}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding Tool}" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Muted}" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [common.details], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding SelectedDevice.DeviceId}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedDevice.DriverDescription}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Reboot" Style="{StaticResource Button.Outline}" Command="{Binding RebootCommand}" Margin="0,0,8,0" />
                        <Button Content="Bootloader" Style="{StaticResource Button.Outline}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,0" />
                        <Button Content="Recovery" Style="{StaticResource Button.Outline}" Command="{Binding RebootRecoveryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
