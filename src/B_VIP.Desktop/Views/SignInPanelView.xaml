<UserControl x:Class="B_VIP.Desktop.Views.SignInPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             xmlns:views="clr-namespace:B_VIP.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SignInPanelViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding [login.title], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="Sign in with the account your administrator issued or you registered."
                   Style="{StaticResource Text.Muted}" Margin="0,0,0,18" TextWrapping="Wrap" />

        <TextBlock Text="{Binding [login.username], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.Label}" />
        <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,10"
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding [login.email], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.Label}" />
        <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,4"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Optional. Used only to reach the activation screen when the account is still pending." />
        <TextBlock Text="{Binding EmailError}" Foreground="{StaticResource Brush.Danger}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="{Binding [login.password], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.Label}" />
        <views:PasswordField Password="{Binding Password, Mode=TwoWay}" Margin="0,0,0,10" />

        <CheckBox Content="{Binding [login.remember], Source={x:Static loc:Localizer.Instance}}"
                  Style="{StaticResource Check.Cyber}" IsChecked="{Binding RememberMe}" Margin="0,0,0,12" />

        <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Accent}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding RequiresBootstrap, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="First-run setup" Foreground="{StaticResource Brush.Accent}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="No administrator exists yet. Enter the bootstrap token from the server configuration together with an e-mail address and the password to use." />
                <TextBlock Text="Bootstrap token" Style="{StaticResource Text.Label}" />
                <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,8"
                         Text="{Binding BootstrapToken, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Administrator e-mail" Style="{StaticResource Text.Label}" />
                <TextBox Style="{StaticResource Input.Text}"
                         Text="{Binding BootstrapEmail, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <Border Background="#1AEF4444" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.White}" TextWrapping="Wrap" />
        </Border>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding [login.submit], Source={x:Static loc:Localizer.Instance}}"
                    Style="{StaticResource Button.Primary}" Command="{Binding LoginCommand}" MinWidth="150" />
            <Button Content="{Binding [login.register], Source={x:Static loc:Localizer.Instance}}"
                    Style="{StaticResource Button.Outline}" Command="{Binding ShowRegisterCommand}" />
        </DockPanel>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
