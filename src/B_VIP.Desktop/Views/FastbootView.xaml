<UserControl x:Class="B_VIP.Desktop.Views.FastbootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FastbootViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [fastboot.title], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.PageTitle}" Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="260" VerticalAlignment="Center"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Serial" Margin="0,0,8,0" />
                    <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding [fastboot.getvar], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                        <TextBox Style="{StaticResource Input.Text}" Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Partition" Style="{StaticResource Text.Label}" />
                        <TextBox Style="{StaticResource Input.Text}" Text="{Binding PartitionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Image file" Style="{StaticResource Text.Label}" />
                        <TextBox Style="{StaticResource Input.Text}" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Read info" Style="{StaticResource Button.Primary}"
                            Command="{Binding ReadInfoCommand}" Margin="0,0,8,8"
                            ToolTip="fastboot getvar all: product, bootloader, baseband, slot and lock state." />
                    <Button Content="{Binding [fastboot.devices], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ListDevicesCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding [fastboot.getvar], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding GetVarCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding [fastboot.flash], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding FlashCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding [fastboot.wipe], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding WipeCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Reboot to" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel>
                        <Button Content="System" Style="{StaticResource Button.Outline}" Command="{Binding RebootSystemCommand}" Margin="0,0,8,8" />
                        <Button Content="Recovery" Style="{StaticResource Button.Outline}" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,8" />
                        <Button Content="Bootloader" Style="{StaticResource Button.Outline}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,8" />
                        <Button Content="EDL" Style="{StaticResource Button.Outline}" Command="{Binding RebootEdlCommand}" Margin="0,0,8,8"
                                ToolTip="fastboot oem edl: Qualcomm emergency download mode." />
                    </WrapPanel>
                </DockPanel>

                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="FRP" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel>
                        <Button Content="Reset FRP" Style="{StaticResource Button.Danger}" Command="{Binding ResetFrpCommand}" Margin="0,0,8,8"
                                ToolTip="Erase frp, config and persistent, then reboot the handset." />
                        <Button Content="Erase frp" Style="{StaticResource Button.Outline}" Command="{Binding EraseFrpCommand}" Margin="0,0,8,8" />
                        <Button Content="Erase config" Style="{StaticResource Button.Outline}" Command="{Binding EraseConfigCommand}" Margin="0,0,8,8" />
                        <Button Content="Erase persistent" Style="{StaticResource Button.Outline}" Command="{Binding ErasePersistentCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </DockPanel>

                <TextBlock Text="{Binding [fastboot.warning], Source={x:Static loc:Localizer.Instance}}"
                           Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBox Grid.Row="2" Style="{StaticResource Input.Text}" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Text="{Binding Output, Mode=OneWay}" />
    </Grid>
</UserControl>
