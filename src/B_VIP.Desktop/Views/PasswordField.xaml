<UserControl x:Class="B_VIP.Desktop.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="32">
    <!--
        One editable surface, two renderers: a PasswordBox while the password is hidden and a
        TextBox while it is revealed. Only one is visible at a time, so the caret and the text
        are never split between two controls.
    -->
    <Grid>
        <PasswordBox x:Name="Masked"
                     Style="{StaticResource Input.Password}"
                     Padding="9,7,34,7"
                     PasswordChanged="OnMaskedPasswordChanged" />

        <TextBox x:Name="Revealed"
                 Style="{StaticResource Input.Text}"
                 Padding="9,7,34,7"
                 Visibility="Collapsed"
                 TextChanged="OnRevealedTextChanged" />

        <ToggleButton x:Name="RevealToggle" Focusable="False"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="30" Height="26" Margin="0,0,2,0"
                      Cursor="Hand" ToolTip="Show or hide the password"
                      Checked="OnRevealChanged" Unchecked="OnRevealChanged">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="4">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="18" Height="18">
                                <Path x:Name="eye"
                                      Data="M 1,9 C 4.4,3.6 13.6,3.6 17,9 C 13.6,14.4 4.4,14.4 1,9 Z"
                                      Stroke="#FF94A3B8" StrokeThickness="1.4" Fill="Transparent"
                                      StrokeLineJoin="Round" />
                                <Ellipse x:Name="pupil" Width="4.4" Height="4.4" Fill="#FF94A3B8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="slash" Data="M 2.6,2.6 L 15.4,15.4"
                                      Stroke="#FF94A3B8" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="eye" Property="Stroke" Value="#FFFFFFFF" />
                            <Setter TargetName="pupil" Property="Fill" Value="#FFFFFFFF" />
                            <Setter TargetName="slash" Property="Stroke" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="eye" Property="Stroke" Value="#FF38BDF8" />
                            <Setter TargetName="pupil" Property="Fill" Value="#FF38BDF8" />
                            <Setter TargetName="slash" Property="Stroke" Value="#FF38BDF8" />
                            <Setter TargetName="slash" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
