<UserControl x:Class="B_VIP.Desktop.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Accent}" VerticalAlignment="Center">
                <TextBlock Text="USB DRIVERS · ONE-CLICK INSTALL" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
            </Border>
            <TextBlock Text="Drivers &amp; Prerequisites" Style="{StaticResource Text.PageTitle}" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Button.Primary}"
                            Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Open bundle folder" Style="{StaticResource Button.Outline}"
                            Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Driver bundle" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding BundleFolder}" Style="{StaticResource Text.Muted}"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Vendor drivers are licensed by the vendor, so the installer ships without them: drop the vendor setup EXE or INF into the bundle folder and this panel installs it with one elevated click. When a package is missing the vendor download page opens instead — nothing is downloaded in the background." />

                <Border Background="#1AEF4444" CornerRadius="4" Padding="10" Margin="0,10,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.White}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Width="170">
                                    <Button Content="{Binding InstallLabel}" Style="{StaticResource Button.Primary}"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,0,6" />
                                    <Button Content="Vendor page" Style="{StaticResource Button.Outline}"
                                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,16,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge.Accent}"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}"
                                                   FontSize="14" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Text.Muted}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Muted}"
                                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
