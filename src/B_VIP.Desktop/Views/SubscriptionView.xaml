<UserControl x:Class="B_VIP.Desktop.Views.SubscriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubscriptionViewModel}">
    <UserControl.Resources>
        <!-- The pricing palette is specified exactly, so it is declared here rather than inherited. -->
        <SolidColorBrush x:Key="Pricing.Navy" Color="#0B132B" />
        <SolidColorBrush x:Key="Pricing.NavyDeep" Color="#0F172A" />
        <SolidColorBrush x:Key="Pricing.Card" Color="#1C2536" />
        <SolidColorBrush x:Key="Pricing.CardAlt" Color="#1E293B" />
        <SolidColorBrush x:Key="Pricing.Accent" Color="#00D2FF" />
        <SolidColorBrush x:Key="Pricing.AccentSoft" Color="#38BDF8" />
        <SolidColorBrush x:Key="Pricing.Text" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Pricing.Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Pricing.Border" Color="#26364A" />

        <!-- All three cards carry the same electric neon-cyan border and glow. -->
        <Style x:Key="Pricing.CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Pricing.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Pricing.Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.65" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pricing.Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pricing.Text}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Pricing.Price" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pricing.Accent}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="Pricing.Subtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pricing.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Pricing.Feature" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pricing.AccentSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="Pricing.Badge" TargetType="Border">
            <Setter Property="Background" Value="#14263A" />
            <Setter Property="BorderBrush" Value="{StaticResource Pricing.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Pricing.BuyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Pricing.Accent}" />
            <Setter Property="Foreground" Value="#04121F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pricing.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pricing.OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Pricing.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{StaticResource Pricing.Accent}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14263A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Pricing.Navy}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Message support" Style="{StaticResource Pricing.OutlineButton}"
                            Command="{Binding ContactCommand}" VerticalAlignment="Center" />
                    <TextBlock Text="Subscription Plans" Foreground="{StaticResource Pricing.Text}"
                               FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Pricing.Subtitle}" Margin="0,0,0,18" TextWrapping="Wrap"
                           Text="Choose a plan and continue on Telegram — the message is pre-filled with the plan and price. Prefer a key? Paste your 16-character activation key below." />

                <Border Background="{StaticResource Pricing.CardAlt}" CornerRadius="10" Padding="14" Margin="0,0,16,18"
                        BorderBrush="{StaticResource Pricing.Border}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="CURRENT PLAN" Foreground="{StaticResource Pricing.Muted}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentPlan}" Foreground="{StaticResource Pricing.Accent}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentExpiry}" Foreground="{StaticResource Pricing.Muted}" FontSize="11" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Your account" Foreground="{StaticResource Pricing.Text}"
                                       FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Telegram support" Style="{StaticResource Pricing.Subtitle}" />
                            <TextBlock Text="{Binding SupportHandle}" Foreground="{StaticResource Pricing.AccentSoft}"
                                       FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Plans}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pricing.CardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource Pricing.Badge}"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Pricing.Accent}"
                                                   FontSize="10" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Pricing.Title}" />
                                    <TextBlock Text="{Binding Price}" Style="{StaticResource Pricing.Price}" />
                                    <TextBlock Text="{Binding Term}" Style="{StaticResource Pricing.Subtitle}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Pricing.Subtitle}"
                                               Margin="0,8,0,10" />

                                    <ItemsControl ItemsSource="{Binding Features}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Pricing.Feature}" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Get this plan on Telegram" Style="{StaticResource Pricing.BuyButton}"
                                            Margin="0,16,0,0"
                                            Command="{Binding DataContext.OpenTelegramCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource Pricing.Card}" CornerRadius="12" Padding="20" Margin="0,0,16,12"
                        BorderBrush="{StaticResource Pricing.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Activate a license key" Style="{StaticResource Pricing.Title}" FontSize="16" />
                        <TextBlock Style="{StaticResource Pricing.Subtitle}" Margin="0,4,0,10"
                                   Text="Enter the 16-character key you received from support. Activation binds it to this workstation." />

                        <DockPanel Width="560" HorizontalAlignment="Left">
                            <Button DockPanel.Dock="Right" Content="Activate License" Style="{StaticResource Pricing.BuyButton}"
                                    Command="{Binding ActivateLicenseCommand}" MinWidth="170" Margin="10,0,0,0" />
                            <TextBox MaxLength="16" FontFamily="Consolas" FontSize="17"
                                     Background="{StaticResource Pricing.NavyDeep}" Foreground="{StaticResource Pricing.Accent}"
                                     CaretBrush="{StaticResource Pricing.Accent}" BorderBrush="{StaticResource Pricing.Border}"
                                     BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center"
                                     Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="{Binding KeyHint}" Style="{StaticResource Pricing.Subtitle}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E" TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
