<UserControl x:Class="B_VIP.Desktop.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SupportViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{Binding [common.refresh], Source={x:Static loc:Localizer.Instance}}"
                    Style="{StaticResource Button.Outline}" Command="{Binding SearchCommand}" />
            <TextBlock Text="{Binding [support.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Tickets}"
                      SelectedItem="{Binding SelectedTicket}" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="90" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Panel.Card}">
                <DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="330" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.PanelAlt}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AuthorName}" Foreground="{StaticResource Brush.GoldSoft}"
                                                   FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBox Style="{StaticResource Input.Text}" TextWrapping="Wrap" Height="70"
                                 Text="{Binding ReplyBody, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{Binding [support.reply], Source={x:Static loc:Localizer.Instance}}"
                                Style="{StaticResource Button.Gold}" Command="{Binding ReplyCommand}"
                                HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding [support.subject], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <TextBox Style="{StaticResource Input.Text}" Margin="0,4,0,0"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{Binding [support.priority], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <ComboBox Style="{StaticResource Input.Select}" Margin="0,4,0,0" ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding NewPriority}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="{Binding [support.message], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <TextBox Style="{StaticResource Input.Text}" Margin="0,4,0,0"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="3" Content="{Binding [support.new], Source={x:Static loc:Localizer.Instance}}"
                        Style="{StaticResource Button.Gold}" Command="{Binding CreateCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
