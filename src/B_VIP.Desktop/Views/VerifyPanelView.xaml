<UserControl x:Class="B_VIP.Desktop.Views.VerifyPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VerifyPanelViewModel}">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Brush.AccentTint}"
                    BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" Margin="0,0,12,0">
                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding [verify.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{Binding StatusMessage}" />

            <Border Style="{StaticResource Panel.Tile}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding [verify.email], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Kicker}" />
                    <TextBlock Text="{Binding Email}" Foreground="{StaticResource Brush.AccentSoft}"
                               FontFamily="Consolas" FontSize="13" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding [verify.code], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Kicker}" />
                    <TextBlock Text="{Binding [verify.codeHint], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding [verify.submitCode], Source={x:Static loc:Localizer.Instance}}"
                                Style="{StaticResource Button.Primary}" Command="{Binding VerifyCodeCommand}"
                                MinWidth="150" Margin="8,0,0,0" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource Input.Text}" MaxLength="6" FontFamily="Consolas"
                                 FontSize="18" Padding="8,4" Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="#1AEF4444" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.White}" TextWrapping="Wrap" />
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding [register.back], Source={x:Static loc:Localizer.Instance}}"
                        Style="{StaticResource Button.Outline}" Command="{Binding BackToSignInCommand}" />
                <Button Content="{Binding ResendLabel}" Style="{StaticResource Button.Primary}"
                        Command="{Binding ResendCommand}" MinWidth="220" HorizontalAlignment="Left" />
            </DockPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding IsActivated, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Account activated" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ActivatedMessage}" Style="{StaticResource Text.Body}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />
            <WrapPanel>
                <Button Content="View subscription plans" Style="{StaticResource Button.Primary}"
                        Command="{Binding ShowPlansCommand}" Margin="0,0,8,8" MinWidth="200" />
                <Button Content="Go to sign in" Style="{StaticResource Button.Outline}"
                        Command="{Binding BackToSignInCommand}" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
