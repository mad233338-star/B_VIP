<UserControl x:Class="B_VIP.Desktop.Views.VendorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             xmlns:controls="clr-namespace:B_VIP.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VendorViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Accent}" VerticalAlignment="Center">
                <TextBlock Text="VENDOR MODULE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- Brand / model header: the pick binds the SoC, engine and loader for this tab. -->
                <controls:DeviceCatalogSelector DataContext="{Binding Catalog}" />

                <StackPanel Orientation="Horizontal" Visibility="{Binding RequiresDevice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="280" VerticalAlignment="Center"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Serial" Margin="0,0,8,0" />
                    <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Margin="0,4,0,0">
                    <!-- Always clickable: with no cable it listens for the chosen platform's interface. -->
                    <Button Content="Reset FRP" Style="{StaticResource Button.Primary}"
                            Command="{Binding ResetFrpCommand}" Margin="0,0,8,8"
                            ToolTip="Waits for the handset when nothing is attached, then erases the FRP partitions through the engine of the selected model." />
                </WrapPanel>

                <!-- Manual package / loader for the routines below. Left empty the bundled default
                     is used; only the bare file name is shown, the full path stays in the tooltip. -->
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding BrowseManualCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Choose a package, download agent, FDL or payload to use instead of the bundled default." />
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Button.Outline}"
                            Command="{Binding ClearManualCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Go back to the bundled / automatic default." />
                    <TextBlock DockPanel.Dock="Left" Text="Manual File / Package / Loader"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding ManualText, Mode=OneWay}"
                             ToolTip="{Binding ManualTooltip}" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Style="{StaticResource Button.Primary}"
                                    Margin="0,0,8,8"
                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding [vendor.notice], Source={x:Static loc:Localizer.Instance}}"
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
