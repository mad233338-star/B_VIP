<Window x:Class="B_VIP.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
        xmlns:views="clr-namespace:B_VIP.Desktop.Views"
        xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="B_VIP Tool — mobile service &amp; GSM toolkit"
        Width="1400" Height="880" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Black}"
        FlowDirection="{Binding IsRightToLeft, Source={x:Static loc:Localizer.Instance}, Converter={StaticResource FlowDirection}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,6">
                    <TextBlock Text="{Binding [app.name], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.Gold}" />
                    <TextBlock Text="{Binding [app.tagline], Source={x:Static loc:Localizer.Instance}}"
                               FontSize="11" Foreground="{StaticResource Brush.Grey}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Line}"
                        BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [nav.account], Source={x:Static loc:Localizer.Instance}}"
                                   Foreground="{StaticResource Brush.GoldDark}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding UserName}" Foreground="{StaticResource Brush.White}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding [common.logout], Source={x:Static loc:Localizer.Instance}}"
                                    Style="{StaticResource Button.Outline}" Command="{Binding LogoutCommand}"
                                    Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.GoldDark}"
                                               FontSize="11" FontWeight="SemiBold" Margin="18,8,18,3" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Button.Nav}" GroupName="b_vip_nav"
                                                             Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UserName}"
                               Foreground="{StaticResource Brush.Grey}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [app.name], Source={x:Static loc:Localizer.Instance}}"
                               Foreground="{StaticResource Brush.GoldSoft}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="#1A0077B6" BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="20,10,20,0"
                    Visibility="{Binding ShowVerificationBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ResendLabel}"
                            Style="{StaticResource Button.Outline}" Padding="10,4" FontSize="11.5"
                            Command="{Binding ResendVerificationCommand}" />
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding VerificationBannerText}" Foreground="{StaticResource Brush.White}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Trial/subscription lockout: red banner, exact wording, one action to renew. -->
            <Border Grid.Row="2" Background="#1AEF4444" BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="20,10,20,0"
                    Visibility="{Binding License.IsLocked, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Renew plan" Style="{StaticResource Button.Primary}"
                            Padding="12,4" FontSize="11.5" Command="{Binding RenewCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding License.BannerText}" Foreground="{StaticResource Brush.White}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="3" Content="{Binding Navigation.Current}" Margin="20,16,20,8"
                            Focusable="False"
                            IsEnabled="{Binding IsWorkspaceEnabled}" />
        </Grid>

        <!-- Live console drawer: every CLI, port and API line lands here. -->
        <views:LiveConsoleView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="220"
                               DataContext="{Binding LiveLog}"
                               Visibility="{Binding DataContext.IsConsoleVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.PanelAlt}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding ConsoleToggleLabel}" Padding="10,2"
                        FontSize="11" Style="{StaticResource Button.Outline}"
                        Command="{Binding ToggleConsoleCommand}" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Navigation.CurrentKey}"
                           Foreground="{StaticResource Brush.Grey}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <!-- Live hardware summary, refreshed by the port watcher without a manual scan. -->
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Grey}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Monitor.IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Monitor.Summary}" ToolTip="{Binding Monitor.Detail}"
                               Foreground="{StaticResource Brush.Grey}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Live licence countdown, e.g. "License Active: 2 day(s) left". -->
                    <TextBlock Text="{Binding License.StatusText}" Foreground="{StaticResource Brush.AccentSoft}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Determinate / indeterminate progress with a cancel action. -->
                    <ProgressBar Width="120" Height="5" Minimum="0" Maximum="100"
                                 Value="{Binding Progress.Percent, Mode=OneWay}"
                                 IsIndeterminate="{Binding Progress.IsIndeterminate}"
                                 Background="{StaticResource Brush.Line}" Foreground="{StaticResource Brush.Accent}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding Progress.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Progress.Caption}" Foreground="{StaticResource Brush.AccentSoft}"
                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    <Button Content="Cancel" Padding="8,1" FontSize="11" Margin="8,0,12,0"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding Progress.CancelCommand}"
                            Visibility="{Binding Progress.CanCancel, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Navigation.Current.StatusMessage}" Foreground="{StaticResource Brush.Grey}"
                               FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                    <TextBlock Text="{Binding Navigation.Current.ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                               FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               Visibility="{Binding Navigation.Current.HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
