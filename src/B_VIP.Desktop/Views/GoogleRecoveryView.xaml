<UserControl x:Class="B_VIP.Desktop.Views.GoogleRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GoogleRecoveryViewModel}">
    <UserControl.Resources>
        <Style x:Key="RecoveryAction" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [nav.google], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" Margin="0" />
            <TextBlock Text="Official Google services, opened in your browser or directly on the connected handset."
                       Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Recovery destinations as cards instead of raw URLs -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Panel.CardHover}" Margin="0,0,10,12" MinHeight="168">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource Brush.AccentTint}"
                                    BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Open portal"
                                        Style="{StaticResource RecoveryAction}"
                                        Command="{Binding DataContext.OpenBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Send to device"
                                        Style="{StaticResource RecoveryAction}"
                                        Command="{Binding DataContext.SendToDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}"
                                           Margin="0,0,0,4" FontSize="14" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Live diagnostics -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="280" VerticalAlignment="Center"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Serial" Margin="0,0,8,0" />
                    <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ScanCommand}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Check FRP &amp; lock status"
                            Style="{StaticResource Button.Outline}" Command="{Binding CheckLockStatusCommand}"
                            VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Reads ro.frp.pst, the OEM unlock flag, verified boot state and Knox/warranty flags from the handset. Account recovery itself always happens in Google's official flow."
                           Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
