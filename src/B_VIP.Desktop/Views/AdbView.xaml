<UserControl x:Class="B_VIP.Desktop.Views.AdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdbViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [adb.title], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.PageTitle}" Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="260" VerticalAlignment="Center"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Serial" Margin="0,0,8,0" />
                    <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ScanCommand}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel Margin="0,12,0,0">
                    <!-- Primary FRP action: setup flag, MASTER_CLEAR broadcast and reboot over adb. -->
                    <Button Content="Reset FRP" Style="{StaticResource Button.Primary}"
                            Command="{Binding ResetFrpCommand}" Margin="0,0,8,8"
                            ToolTip="Writes user_setup_complete, sends android.intent.action.MASTER_CLEAR, brings the launcher forward and reboots. Needs an authorized ADB connection." />
                    <Button Content="Read info" Style="{StaticResource Button.Outline}"
                            Command="{Binding ReadInfoCommand}" Margin="0,0,8,8"
                            ToolTip="adb devices -l and getprop: model, build, Android version and security patch." />
                    <Button Content="{Binding [adb.devices], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ListDevicesCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="{Binding [adb.restart], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding RestartServerCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="{Binding [nav.diagnostics], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ConnectionCheckCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="{Binding [adb.logcat], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding CollectLogcatCommand}"
                            Margin="0,0,8,8" />

                </WrapPanel>

                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Reboot to" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel>
                        <Button Content="System" Style="{StaticResource Button.Outline}" Command="{Binding RebootSystemCommand}" Margin="0,0,8,8" />
                        <Button Content="Recovery" Style="{StaticResource Button.Outline}" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,8" />
                        <Button Content="Bootloader" Style="{StaticResource Button.Outline}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,8" />
                        <Button Content="EDL" Style="{StaticResource Button.Outline}" Command="{Binding RebootEdlCommand}" Margin="0,0,8,8"
                                ToolTip="adb reboot edl: Qualcomm emergency download mode." />
                        <Button Content="Download" Style="{StaticResource Button.Outline}" Command="{Binding RebootDownloadCommand}" Margin="0,0,8,8"
                                ToolTip="adb reboot download: Samsung Download (Odin) mode." />
                    </WrapPanel>
                </DockPanel>

                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding [adb.run], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding RunShellCommand}" />
                    <TextBox Style="{StaticResource Input.Text}" Text="{Binding ShellCommand, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding [adb.shell], Source={x:Static loc:Localizer.Instance}}"
                           Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <TextBox Grid.Row="2" Style="{StaticResource Input.Text}" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Text="{Binding Output, Mode=OneWay}" />
    </Grid>
</UserControl>