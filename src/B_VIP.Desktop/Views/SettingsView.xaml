<UserControl x:Class="B_VIP.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [settings.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" Margin="0,0,0,12" />

            <Border Style="{StaticResource Panel.Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.server], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <!-- The endpoint is compiled in; only the host is shown, never a route. -->
                    <TextBlock Text="{Binding CloudService}" Foreground="{StaticResource Brush.AccentSoft}"
                               FontFamily="Consolas" FontSize="12.5" Margin="0,4,0,12" />

                    <TextBlock Text="{Binding [settings.platformTools], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <TextBox Style="{StaticResource Input.Text}" Margin="0,4,0,12"
                             Text="{Binding PlatformToolsPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding [settings.language], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="English" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />

                    <TextBlock Text="{Binding [settings.theme], Source={x:Static loc:Localizer.Instance}}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding [settings.themeValue], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Body}" Margin="0,4,0,12" />

                    <TextBlock Text="Server status" Style="{StaticResource Text.Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource Brush.GoldSoft}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding BackendVersion}" Style="{StaticResource Text.Muted}" />
                    </StackPanel>

                    <Button Content="{Binding [common.save], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Gold}" Command="{Binding SaveCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
