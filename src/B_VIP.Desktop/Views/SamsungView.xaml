<UserControl x:Class="B_VIP.Desktop.Views.SamsungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             xmlns:controls="clr-namespace:B_VIP.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SamsungViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Accent}" VerticalAlignment="Center">
                <TextBlock Text="SAMSUNG · MTP / TEST MODE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
            </Border>
            <TextBlock Text="Samsung" Style="{StaticResource Text.PageTitle}" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- Samsung model header: A04 / A05 / A06 and friends, with the SoC the preloader
                     routine must expect. The pick also supplies the matching download agent. -->
                <controls:DeviceCatalogSelector DataContext="{Binding Catalog}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [devices.title], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="280" VerticalAlignment="Center"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Serial" Margin="0,0,8,0" />
                    <Button Content="{Binding [devices.scan], Source={x:Static loc:Localizer.Instance}}"
                            Style="{StaticResource Button.Outline}" Command="{Binding ScanCommand}"
                            VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Read Info (MTP)" Style="{StaticResource Button.Primary}"
                            Command="{Binding ReadInfoCommand}" Margin="0,0,8,8"
                            ToolTip="MTP identity plus firmware, CSC and Android version when adb is authorized." />
                    <Button Content="Reboot to Download" Style="{StaticResource Button.Outline}"
                            Command="{Binding RebootDownloadCommand}" Margin="0,0,8,8"
                            ToolTip="adb reboot download: Samsung Download (Odin) mode." />
                    <Button Content="Reboot to System" Style="{StaticResource Button.Outline}"
                            Command="{Binding RebootSystemCommand}" Margin="0,0,8,8" />
                    <Button Content="Reboot to Recovery" Style="{StaticResource Button.Outline}"
                            Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,8"
                            ToolTip="adb reboot recovery, with fastboot reboot recovery as the fallback." />
                </WrapPanel>

                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Open on device" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Open browser" Style="{StaticResource Button.Outline}"
                            Command="{Binding OpenBrowserCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <ComboBox Style="{StaticResource Input.Select}" Width="170" VerticalAlignment="Center"
                              ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding SelectedBrowser}"
                              DisplayMemberPath="Label" Margin="0,0,8,0" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center"
                             IsEnabled="{Binding CanEditCustomUrl}"
                             Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Only used by the Custom URL entry." />
                </DockPanel>

                <!-- Manual package / loader. Left empty the selected model's bundled download agent is
                     used; only the bare file name is shown, the full path stays in the tooltip. -->
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding BrowseManualCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Choose a package, download agent or firmware file to use instead of the bundled default." />
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Button.Outline}"
                            Command="{Binding ClearManualCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Go back to the bundled / automatic default." />
                    <TextBlock DockPanel.Dock="Left" Text="Manual File / Package / Loader"
                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding ManualText, Mode=OneWay}"
                             ToolTip="{Binding ManualTooltip}" />
                </DockPanel>

                <DockPanel Margin="0,10,0,0">
                    <WrapPanel>
                        <Button Content="Reset FRP (Preloader)" Style="{StaticResource Button.Primary}"
                                Command="{Binding ResetFrpPreloaderCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                ToolTip="Samsung handsets (A04/A05/A06): erases 'frp' through the boot ROM with the engine of the selected model. Always clickable — it listens for the handset when none is attached." />
                        <Button Content="Reset FRP (*#0*# / ADB)" Style="{StaticResource Button.Outline}"
                                Command="{Binding ResetFrpCommand}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Preloader: hold Vol+ and Vol- while connecting the cable. Modem routine: handshakes the Samsung modem at 115200 baud, waits for an authorized adb connection, then clears the setup flags and reboots." />
                </DockPanel>

                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="MTP exposes model and manufacturer only; it has no reboot or URL verb. Serial, firmware and CSC are read over an authorized adb connection." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
