<UserControl x:Class="B_VIP.Desktop.Views.MtkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MtkViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Accent}" VerticalAlignment="Center">
                <TextBlock Text="MEDIATEK · BROM / PRELOADER / FASTBOOT" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
            </Border>
            <!-- Micro status pill: the loader state at a glance, without opening the card. -->
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Status}" VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    BorderBrush="{Binding Loaders.Status, Converter={StaticResource StatusToBrush}}">
                <TextBlock Text="{Binding Loaders.HeaderStatusText}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Loaders.Status, Converter={StaticResource StatusToBrush}}" />
            </Border>
            <TextBlock Text="MediaTek" Style="{StaticResource Text.PageTitle}" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- LastChildFill stays off so the primary action keeps its own width instead of
                     stretching across the header when it is the last dock child. -->
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Interfaces" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Button.Outline}"
                            Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="BROM handshake" Style="{StaticResource Button.Primary}"
                            Command="{Binding HandshakeCommand}" VerticalAlignment="Center"
                            ToolTip="Opens each MediaTek port and reports what it answers. The boot-ROM stage needs a vendor download agent." />
                </DockPanel>

                <Border Margin="0,10,0,0" Background="{StaticResource Brush.Surface}" CornerRadius="4"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Height="96">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <ItemsControl ItemsSource="{Binding Ports}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}"
                                               FontFamily="Consolas" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Read Info" Style="{StaticResource Button.Outline}"
                            Command="{Binding ReadInfoCommand}" Margin="0,0,8,8"
                            ToolTip="Platform, SoC, build and security properties plus the attached MTK interfaces." />
                    <ComboBox Style="{StaticResource Input.Select}" Width="130" Margin="0,0,8,8"
                              VerticalAlignment="Center" ItemsSource="{Binding RebootTargets}"
                              SelectedItem="{Binding SelectedRebootTarget}" />
                    <Button Content="Reboot" Style="{StaticResource Button.Outline}"
                            Command="{Binding RebootCommand}" Margin="0,0,8,8" />
                    <!-- One Reset FRP action: mtkclient through the boot ROM, which also works on a
                         locked bootloader. Always clickable — it listens for the preloader. -->
                    <Button Content="Reset FRP" Style="{StaticResource Button.Primary}"
                            Command="{Binding ResetFrpCommand}" Margin="0,0,8,8"
                            ToolTip="mtkclient: erases 'frp' and 'persistent' through the boot ROM, then resets. Works on a locked bootloader. Hold Vol+ and Vol- while connecting the cable." />
                    <Button Content="Factory Reset" Style="{StaticResource Button.Outline}"
                            Command="{Binding FactoryResetCommand}" Margin="0,0,8,8"
                            ToolTip="fastboot -w plus userdata, cache and metadata. NVRAM and radio calibration are never touched." />
                </WrapPanel>

                <!-- Boot-ROM workbench: lock state, NVRAM and the safe userdata format. All of it
                     goes through the same mtkclient bundle and listens for the preloader. -->
                <WrapPanel Margin="0,0,0,0">
                    <Button Content="Unlock bootloader" Style="{StaticResource Button.Outline}"
                            Command="{Binding UnlockBootloaderCommand}" Margin="0,0,8,8"
                            ToolTip="mtkclient erases 'seccfg' through the boot ROM. The handset wipes itself on the next boot." />
                    <Button Content="Relock bootloader" Style="{StaticResource Button.Outline}"
                            Command="{Binding RelockBootloaderCommand}" Margin="0,0,8,8"
                            ToolTip="Writes a previously dumped seccfg.bin back, restoring the locked state." />
                    <Button Content="Backup NVRAM" Style="{StaticResource Button.Primary}"
                            Command="{Binding BackupNvramCommand}" Margin="0,0,8,8"
                            ToolTip="Dumps nvram, nvdata, nvcfg, protect1 and protect2 into Backups\\NV with a timestamp." />
                    <Button Content="Restore NVRAM" Style="{StaticResource Button.Outline}"
                            Command="{Binding RestoreNvramCommand}" Margin="0,0,8,8"
                            ToolTip="Writes an NVRAM backup back, partition by partition. Handset-specific: never use another phone's dump." />
                    <Button Content="Safe format" Style="{StaticResource Button.Outline}"
                            Command="{Binding SafeFormatCommand}" Margin="0,0,8,8"
                            ToolTip="Erases userdata only. metadata and the persistent FRP flags survive, which breaks encryption loops without clearing the account." />
                </WrapPanel>

                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Outline}"
                            Command="{Binding BrowseScatterCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Read scatter" Style="{StaticResource Button.Primary}"
                            Command="{Binding ScatterCommand}" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center" IsReadOnly="True"
                             Text="{Binding ScatterName, Mode=OneWay}"
                             ToolTip="{Binding ScatterTooltip}" />
                </DockPanel>

                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Erase, format and flash commands go through fastboot on an unlocked bootloader. Reading or writing the boot ROM needs MediaTek's download agent and a libusb transport, which this build does not ship." />
            </StackPanel>
        </Border>

        <!-- Loader bundle: only on screen while it is missing, moving or failed. An installed
             bundle collapses the card and hands its height to the results grid below. -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,0,0,12"
                Visibility="{Binding Loaders.ShowCard, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Loaders" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Status}" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Loaders.StatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Button.Outline}"
                            Command="{Binding Loaders.CancelCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Loaders.IsProvisioning, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding Loaders.PrepareButtonText}" Style="{StaticResource Button.Outline}"
                            Command="{Binding Loaders.PrepareCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Loaders.ShowPrepareButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Fetches and installs the MediaTek loader bundle." />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Loaders.PackageName}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             Value="{Binding Loaders.Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding Loaders.IsIndeterminate}"
                             Visibility="{Binding Loaders.ShowProgressBar, Converter={StaticResource BoolToVisibility}}"
                             Background="{StaticResource Brush.Line}" Foreground="{StaticResource Brush.Accent}" />

                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Loaders.Detail}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource Grid.Data}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
