<UserControl x:Class="B_VIP.Desktop.Views.PlansPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:views="clr-namespace:B_VIP.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlansPanelViewModel}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Choose your subscription" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Your 3-day trial is already running. Pick the tier you want after it ends; activation keys are issued by the administrator." />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Success}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Background="#1AEF4444" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.White}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Continue to sign in"
                    Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}" MinWidth="190" />
            <TextBlock Text="Plans are informational here; no payment is taken by the desktop client."
                       Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Grid>
            <views:SubscriptionCardsView />
            <Border Style="{StaticResource Panel.Card}" VerticalAlignment="Bottom" Margin="0,8,0,0"
                    Visibility="{Binding HasInstructions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="How to activate" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding Instructions}" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
