<UserControl x:Class="B_VIP.Desktop.Views.RegisterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             xmlns:views="clr-namespace:B_VIP.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RegisterPanelViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding [register.title], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="A 3-day full-access trial starts as soon as the account is activated."
                   Style="{StaticResource Text.Muted}" Margin="0,0,0,18" TextWrapping="Wrap" />

        <TextBlock Text="{Binding [register.username], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.Label}" />
        <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,10"
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding [register.email], Source={x:Static loc:Localizer.Instance}}"
                   Style="{StaticResource Text.Label}" />
        <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,4"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding EmailError}" Foreground="{StaticResource Brush.Danger}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVisibility}}" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding [register.password], Source={x:Static loc:Localizer.Instance}}"
                           Style="{StaticResource Text.Label}" />
                <views:PasswordField Password="{Binding Password, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding [register.confirm], Source={x:Static loc:Localizer.Instance}}"
                           Style="{StaticResource Text.Label}" />
                <views:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <WrapPanel Margin="0,0,0,12">
            <TextBlock Text="Passwords match" FontSize="11.5" Foreground="{StaticResource Brush.Success}"
                       Margin="0,0,10,0"
                       Visibility="{Binding PasswordsMatch, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding [register.mismatch], Source={x:Static loc:Localizer.Instance}}"
                       FontSize="11.5" Foreground="{StaticResource Brush.Danger}" Margin="0,0,10,0"
                       Visibility="{Binding PasswordsMismatch, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Minimum 10 characters, letters and digits."
                       FontSize="11.5" Foreground="{StaticResource Brush.Muted}" />
        </WrapPanel>

        <!-- The checkbox owns its own column so the sentence can wrap inside the remaining width
             instead of being clipped by the checkbox's content presenter. The links open the full
             legal text in the in-app overlay. -->
        <Grid Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" Style="{StaticResource Check.Cyber}"
                      IsChecked="{Binding AcceptedTerms}"
                      VerticalAlignment="Top" Margin="0,3,9,0" />

            <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.White}" FontSize="12.5"
                       TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center">
                <!-- One line on purpose: whitespace between inlines is significant in a TextBlock. -->
                <Run Text="I accept the " /><Hyperlink Command="{Binding ShowLegalCommand}" CommandParameter="terms" Foreground="{StaticResource Brush.Accent}"><Run Text="Terms &amp; Conditions" /></Hyperlink><Run Text=" and " /><Hyperlink Command="{Binding ShowLegalCommand}" CommandParameter="privacy" Foreground="{StaticResource Brush.Accent}"><Run Text="Privacy Policy" /></Hyperlink><Run Text="." />
            </TextBlock>
        </Grid>

        <Border Background="#1AEF4444" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.White}" TextWrapping="Wrap" />
        </Border>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding [register.back], Source={x:Static loc:Localizer.Instance}}"
                        Style="{StaticResource Button.Outline}" Command="{Binding BackToSignInCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding [register.submit], Source={x:Static loc:Localizer.Instance}}"
                        Style="{StaticResource Button.Primary}" Command="{Binding SubmitCommand}" MinWidth="150" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</UserControl>
