<UserControl x:Class="B_VIP.Desktop.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:B_VIP.Desktop.ViewModels"
             xmlns:loc="clr-namespace:B_VIP.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LicenseViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding [license.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.PageTitle}" Margin="0,0,0,12" />

            <!-- current subscription -->
            <Border Style="{StaticResource Panel.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding [tiers.active], Source={x:Static loc:Localizer.Instance}}"
                                   Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding CurrentTierLabel}" Foreground="{StaticResource Brush.Accent}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DaysRemaining}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding CurrentLicense.ExpiresAt, StringFormat= · expires {0:yyyy-MM-dd}}"
                                       Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Badge.Accent}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.Accent}"
                                   FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- tier cards -->
            <TextBlock Text="{Binding [tiers.title], Source={x:Static loc:Localizer.Instance}}"
                       Style="{StaticResource Text.Section}" />
            <ItemsControl ItemsSource="{Binding Tiers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel.CardHover}" Margin="0,0,10,12" MinHeight="250">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource Brush.Accent}"
                                               FontSize="20" FontWeight="Bold" />
                                    <Button Content="{Binding [tiers.select], Source={x:Static loc:Localizer.Instance}}"
                                            Style="{StaticResource Button.Primary}" Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.SelectTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}"
                                               Margin="0,0,0,2" FontSize="16" />
                                    <TextBlock Text="{Binding Billing}" Style="{StaticResource Text.Kicker}" />

                                    <Border Style="{StaticResource Divider.Cyber}" />

                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="{Binding DevicesText}" Style="{StaticResource Text.Muted}" />

                                    <Border Style="{StaticResource Divider.Cyber}" />

                                    <TextBlock Text="{Binding Features}" Style="{StaticResource Text.Muted}"
                                               FontSize="12" LineHeight="18" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- activation -->
            <Border Style="{StaticResource Panel.Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [tiers.payment], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding [tiers.paymentNote], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding PaymentNote}" Foreground="{StaticResource Brush.AccentSoft}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding HasSelectedTier, Converter={StaticResource BoolToVisibility}}" />

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{Binding [license.verify], Source={x:Static loc:Localizer.Instance}}"
                                    Style="{StaticResource Button.Outline}" Command="{Binding VerifyCommand}" Margin="8,0,0,0" />
                            <Button Content="{Binding [license.deactivate], Source={x:Static loc:Localizer.Instance}}"
                                    Style="{StaticResource Button.Outline}" Command="{Binding DeactivateCommand}" Margin="8,0,0,0" />
                            <Button Content="{Binding [license.activate], Source={x:Static loc:Localizer.Instance}}"
                                    Style="{StaticResource Button.Primary}" Command="{Binding ActivateCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBox Style="{StaticResource Input.Text}" VerticalAlignment="Center"
                                 Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="{Binding VerificationText}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- activation history -->
            <Border Style="{StaticResource Panel.Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [license.activations], Source={x:Static loc:Localizer.Instance}}"
                               Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                    <DataGrid Style="{StaticResource Grid.Data}" ItemsSource="{Binding Activations}" Height="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
                            <DataGridTextColumn Header="Fingerprint" Binding="{Binding DeviceFingerprint}" Width="220" />
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="110" />
                            <DataGridTextColumn Header="Activated" Binding="{Binding ActivatedUtc, StringFormat=yyyy-MM-dd}" Width="120" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
