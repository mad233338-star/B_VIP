<UserControl x:Class="B_VIP.Admin.AdminConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:B_VIP.Admin">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AdminPanel" Color="#FF111827" />
            <SolidColorBrush x:Key="AdminLine" Color="#FF24303F" />
            <SolidColorBrush x:Key="AdminText" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AdminGold" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="AdminMuted" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="AdminCard" Color="#FF1F2937" />
            <admin:ListJoinConverter x:Key="ListJoin" />

            <Style x:Key="AdminTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AdminText}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="AdminHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AdminGold}" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>

            <Style x:Key="AdminBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AdminText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AdminButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AdminGold}" />
                <Setter Property="Foreground" Value="#FF0B0B0C" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="AdminGhostButton" TargetType="Button" BasedOn="{StaticResource AdminButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AdminGold}" />
                <Setter Property="BorderBrush" Value="{StaticResource AdminGold}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="AdminMiniButton" TargetType="Button" BasedOn="{StaticResource AdminGhostButton}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="AdminDangerButton" TargetType="Button" BasedOn="{StaticResource AdminMiniButton}">
                <Setter Property="Foreground" Value="#FFEF4444" />
                <Setter Property="BorderBrush" Value="#FFEF4444" />
            </Style>

            <Style x:Key="AdminInput" TargetType="TextBox">
                <Setter Property="Background" Value="#FF0F172A" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="CaretBrush" Value="#FF00D2FF" />
                <Setter Property="BorderBrush" Value="#FF334155" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <!-- Grid palette. The stock WPF grid paints white rows over a light header, which
                 is why this table showed a white background and invisible white text. -->
            <SolidColorBrush x:Key="AdminHeaderFill" Color="#FF1E293B" />
            <SolidColorBrush x:Key="AdminRowFill" Color="#FF0F172A" />
            <SolidColorBrush x:Key="AdminRowAltFill" Color="#FF1E293B" />
            <SolidColorBrush x:Key="AdminGridLineFill" Color="#FF334155" />
            <SolidColorBrush x:Key="AdminSelectedFill" Color="#FF2563EB" />

            <Style x:Key="AdminGridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource AdminHeaderFill}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderBrush" Value="{StaticResource AdminGridLineFill}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AdminGridCell" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource AdminGridLineFill}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AdminSelectedFill}" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AdminGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="{StaticResource AdminRowFill}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AdminSelectedFill}" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tab headers: the stock template paints a light strip, which was the remaining
                 white block above the tables. -->
            <Style x:Key="AdminTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource AdminMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="tab" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                    CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tab" Property="Background" Value="#FF1E293B" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="tab" Property="Background" Value="#FF1E293B" />
                                    <Setter TargetName="tab" Property="BorderBrush" Value="#FF00D2FF" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AdminGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource AdminRowFill}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource AdminGridLineFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="RowBackground" Value="{StaticResource AdminRowFill}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource AdminRowAltFill}" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AdminGridLineFill}" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource AdminGridHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource AdminGridCell}" />
                <Setter Property="RowStyle" Value="{StaticResource AdminGridRow}" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="RowHeight" Value="30" />
                <Setter Property="ColumnHeaderHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="Admin dashboard" Style="{StaticResource AdminTitle}" DockPanel.Dock="Left" />
            <Button Content="Refresh" Style="{StaticResource AdminButton}" DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Users" Style="{StaticResource AdminBody}" Foreground="{StaticResource AdminMuted}" />
                    <TextBlock Text="{Binding Overview.TotalUsers}" Foreground="{StaticResource AdminGold}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Active licenses" Style="{StaticResource AdminBody}" Foreground="#FF9A9A9E" />
                    <TextBlock Text="{Binding Overview.ActiveLicenses}" Foreground="{StaticResource AdminGold}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Open tickets" Style="{StaticResource AdminBody}" Foreground="#FF9A9A9E" />
                    <TextBlock Text="{Binding Overview.OpenTickets}" Foreground="{StaticResource AdminGold}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Operations (24h)" Style="{StaticResource AdminBody}" Foreground="#FF9A9A9E" />
                    <TextBlock Text="{Binding Overview.OperationsLast24h}" Foreground="{StaticResource AdminGold}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="Security events (24h)" Style="{StaticResource AdminBody}" Foreground="#FF9A9A9E" />
                    <TextBlock Text="{Binding Overview.SecurityEventsLast24h}" Foreground="{StaticResource AdminGold}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AdminText}"
                    ItemContainerStyle="{StaticResource AdminTab}">
            <TabItem Header="Technicians">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- live metrics -->
                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,10">
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Registered technicians" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.TotalTechnicians}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Active subscriptions" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.ActiveSubscriptions}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pending verification" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.PendingVerifications}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Suspended" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.Suspended}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Bound workstations" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.HardwareBindings}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Diagnostic logs" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Metrics.OperationsLogged}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Expired accounts" Foreground="{StaticResource AdminMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Overview.ExpiredLicenses}" Foreground="{StaticResource AdminGold}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- search and extension controls: dark container, dark inputs, white text -->
                    <Border Grid.Row="1" Background="#FF0F172A" BorderBrush="#FF334155"
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Extend by (days)" Foreground="{StaticResource AdminMuted}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Style="{StaticResource AdminInput}" Width="70"
                                         Text="{Binding ExtendDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <Button Content="Refresh" Style="{StaticResource AdminButton}" Command="{Binding SearchTechniciansCommand}" />
                            </StackPanel>
                            <TextBox Style="{StaticResource AdminInput}" Width="300" HorizontalAlignment="Left"
                                     Text="{Binding TechnicianSearch, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Search by username, e-mail or HWID" Foreground="{StaticResource AdminMuted}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="2" Style="{StaticResource AdminGrid}" ItemsSource="{Binding Technicians}"
                              SelectedItem="{Binding SelectedTechnician}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="140" />
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="200" />
                            <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredText}" Width="100" />
                            <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="120" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryText}" Width="100" />
                            <DataGridTextColumn Header="Bound HWID" Binding="{Binding HardwareId}" Width="200" />
                            <DataGridTextColumn Header="Resets" Binding="{Binding HardwareResetText}" Width="60" />
                            <DataGridTextColumn Header="Verification" Binding="{Binding VerificationText}" Width="95" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                            <DataGridTemplateColumn Header="Actions" Width="*" MinWidth="360">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding StatusAction}" Style="{StaticResource AdminMiniButton}"
                                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Reset HWID" Style="{StaticResource AdminMiniButton}"
                                                    Command="{Binding DataContext.ResetHardwareIdCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{Binding VerifyAction}" Style="{StaticResource AdminMiniButton}"
                                                    Command="{Binding DataContext.ToggleVerifiedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Extend" Style="{StaticResource AdminMiniButton}"
                                                    Command="{Binding DataContext.ExtendSubscriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <ComboBox Width="120" Margin="0,0,6,0"
                                                      ItemsSource="{Binding DataContext.Plans, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding PlanChoice, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      Background="{StaticResource AdminCard}"
                                                      Foreground="{StaticResource AdminText}" Padding="4,2" />
                                            <Button Content="Move" Style="{StaticResource AdminMiniButton}"
                                                    Command="{Binding DataContext.ChangePlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource AdminDangerButton}"
                                                    Command="{Binding DataContext.DeleteTechnicianCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- license key generator -->
                    <Border Grid.Row="3" Background="{StaticResource AdminCard}" BorderBrush="{StaticResource AdminLine}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="License generator" Foreground="{StaticResource AdminGold}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Width="180" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                                          DisplayMemberPath="Name" Background="{StaticResource AdminCard}"
                                          Foreground="{StaticResource AdminText}" Padding="6,3" Margin="0,0,8,0" />
                                <Button Content="Generate BVIP key" Style="{StaticResource AdminButton}"
                                        Command="{Binding GenerateLicenseCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GeneratedKey}" Foreground="{StaticResource AdminGold}"
                                       FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Plans">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- tier editor -->
                    <Border Grid.Column="0" Background="{StaticResource AdminCard}"
                            BorderBrush="{StaticResource AdminLine}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Subscription tiers" Foreground="{StaticResource AdminGold}"
                                       FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Create a new tier or load one from the list to edit it."
                                       Foreground="{StaticResource AdminMuted}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="Code (unique)" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                            <TextBox Style="{StaticResource AdminInput}" Margin="0,3,0,8"
                                     Text="{Binding PlanCode, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Title" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                            <TextBox Style="{StaticResource AdminInput}" Margin="0,3,0,8"
                                     Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Features / description" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                            <TextBox Style="{StaticResource AdminInput}" Margin="0,3,0,8" Height="56"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding PlanDescription, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Duration (days)" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                                    <TextBox Style="{StaticResource AdminInput}"
                                             Text="{Binding PlanDurationDays, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Concurrent PCs" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                                    <TextBox Style="{StaticResource AdminInput}"
                                             Text="{Binding PlanMaxActivations, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Price" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                                    <TextBox Style="{StaticResource AdminInput}"
                                             Text="{Binding PlanPrice, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Currency" Foreground="{StaticResource AdminMuted}" FontSize="11.5" />
                                    <TextBox Style="{StaticResource AdminInput}"
                                             Text="{Binding PlanCurrency, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Lifetime plan" IsChecked="{Binding PlanIsLifetime}"
                                      Foreground="{StaticResource AdminText}" Margin="0,0,0,4" />
                            <CheckBox Content="Active (visible on the plans screen)" IsChecked="{Binding PlanIsActive}"
                                      Foreground="{StaticResource AdminText}" Margin="0,0,0,10" />

                            <WrapPanel>
                                <Button Content="Create" Style="{StaticResource AdminButton}"
                                        Command="{Binding CreatePlanCommand}" Margin="0,0,6,6" />
                                <Button Content="Save changes" Style="{StaticResource AdminButton}"
                                        Command="{Binding SavePlanCommand}" Margin="0,0,6,6" />
                                <Button Content="Deactivate" Style="{StaticResource AdminButton}"
                                        Command="{Binding DeactivatePlanCommand}" Margin="0,0,6,6" />
                                <Button Content="Activate" Style="{StaticResource AdminButton}"
                                        Command="{Binding ActivatePlanCommand}" Margin="0,0,6,6" />
                                <Button Content="Delete" Style="{StaticResource AdminDangerButton}"
                                        Command="{Binding DeletePlanCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- tier list -->
                    <DataGrid Grid.Column="1" Style="{StaticResource AdminGrid}" ItemsSource="{Binding Plans}"
                              SelectedItem="{Binding SelectedPlan}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Days" Binding="{Binding DurationDays}" Width="70" />
                            <DataGridTextColumn Header="PCs" Binding="{Binding MaxActivations}" Width="60" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90" />
                            <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="80" />
                            <DataGridTextColumn Header="Licenses" Binding="{Binding LicenseCount}" Width="80" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Licenses">
                <DataGrid Style="{StaticResource AdminGrid}" Margin="0,8" ItemsSource="{Binding Licenses}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding LicenseKey}" Width="240" />
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="130" />
                        <DataGridTextColumn Header="Plan" Binding="{Binding PlanName}" Width="130" />
                        <DataGridTextColumn Header="Status" Binding="{Binding EffectiveStatus}" Width="110" />
                        <DataGridTextColumn Header="Activations" Binding="{Binding CurrentActivations}" Width="100" />
                        <DataGridTextColumn Header="Expires (UTC)" Binding="{Binding ExpiresAt}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Roles">
                <DataGrid Style="{StaticResource AdminGrid}" Margin="0,8" ItemsSource="{Binding Roles}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="280" />
                        <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions, Converter={StaticResource ListJoin}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Settings">
                <DockPanel Margin="0,8">
                    <Button DockPanel.Dock="Top" Content="Save selected setting" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Command="{Binding UpdateSettingCommand}" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource AdminGrid}" ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                            <DataGridCheckBoxColumn Header="Secret" Binding="{Binding IsSecret, Mode=OneWay}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Integrations">
                <DockPanel Margin="0,8">
                    <Button DockPanel.Dock="Top" Content="Test selected integration" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Command="{Binding TestIntegrationCommand}" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource AdminGrid}" ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                            <DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70" />
                            <DataGridCheckBoxColumn Header="Configured" Binding="{Binding IsConfigured}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Audit log">
                <DataGrid Style="{StaticResource AdminGrid}" Margin="0,8" ItemsSource="{Binding AuditEvents}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredUtc}" Width="150" />
                        <DataGridTextColumn Header="Actor" Binding="{Binding ActorName}" Width="140" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180" />
                        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Backups">
                <DockPanel Margin="0,8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Style="{StaticResource AdminInput}" Width="260" Text="{Binding NewBackupNote, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Create backup" Style="{StaticResource AdminButton}" Command="{Binding CreateBackupCommand}" Margin="8,0,8,0" />
                        <Button Content="Restore selected" Style="{StaticResource AdminGhostButton}" Command="{Binding RestoreBackupCommand}"
                                CommandParameter="{Binding SelectedBackup}" />
                    </StackPanel>
                    <DataGrid Style="{StaticResource AdminGrid}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedUtc}" Width="150" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="100" />
                            <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" />
                            <DataGridTextColumn Header="Performed by" Binding="{Binding PerformedBy}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Releases">
                <DataGrid Style="{StaticResource AdminGrid}" Margin="0,8" ItemsSource="{Binding Releases}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                        <DataGridCheckBoxColumn Header="Mandatory" Binding="{Binding IsMandatory}" Width="90" />
                        <DataGridTextColumn Header="Published (UTC)" Binding="{Binding PublishedUtc}" Width="150" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding ReleaseNotes}" Width="*" />
                        <DataGridTextColumn Header="Download" Binding="{Binding DownloadUrl}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Maintenance">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,12">
                    <TextBlock Text="Maintenance mode" Style="{StaticResource AdminHeading}" />
                    <CheckBox Content="Enable maintenance mode" IsChecked="{Binding Maintenance.Enabled}"
                              Foreground="{StaticResource AdminText}" Margin="0,4,0,8" />
                    <TextBlock Text="Message" Style="{StaticResource AdminBody}" />
                    <TextBox Style="{StaticResource AdminInput}" Text="{Binding Maintenance.Message, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Starts at (UTC, ISO-8601, optional)" Style="{StaticResource AdminBody}" />
                    <TextBox Style="{StaticResource AdminInput}" Text="{Binding Maintenance.StartsAt, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Ends at (UTC, ISO-8601, optional)" Style="{StaticResource AdminBody}" />
                    <TextBox Style="{StaticResource AdminInput}" Text="{Binding Maintenance.EndsAt, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />
                    <Button Content="Apply" Style="{StaticResource AdminButton}" HorizontalAlignment="Left" Command="{Binding SaveMaintenanceCommand}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="System">
                <StackPanel Margin="0,12">
                    <TextBlock Text="Server" Style="{StaticResource AdminHeading}" />
                    <TextBlock Style="{StaticResource AdminBody}">
                        <Run Text="Status: " /><Run Text="{Binding Overview.ServerStatus, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource AdminBody}">
                        <Run Text="Database: " /><Run Text="{Binding Overview.DatabaseStatus, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource AdminBody}">
                        <Run Text="Integrations: " /><Run Text="{Binding Overview.IntegrationsStatus, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource AdminBody}">
                        <Run Text="Last backup (UTC): " /><Run Text="{Binding Overview.LastBackupUtc, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" VerticalAlignment="Bottom" Height="28">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource AdminBody}" Foreground="{StaticResource AdminGold}" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource AdminBody}" Foreground="#FFE06C5B" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</UserControl>
